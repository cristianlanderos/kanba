# Kanba keeps everything in one Postgres database. With docker compose, set the password
# and the rest follows. Without it, set DATABASE_URL yourself.

# The password of the database that docker-compose.yml starts. Letters and digits only,
# because it becomes part of a URL.
POSTGRES_PASSWORD=

# Where the database is, when you run Kanba without docker compose (npm run dev).
# The user must be allowed to create roles and schemas: the database's owner.
# DATABASE_URL=postgresql://kanba:password@localhost:5432/kanba

# Anyone who can open the site can sign up. Set this to false once your people have accounts.
KANBA_ALLOW_SIGNUP=true

# New accounts get this plan. "pro" lifts the free plan's limit of one project, which only
# makes sense where Stripe sells the upgrade.
KANBA_DEFAULT_PLAN=pro

# The port on this machine, and where the database files go (a folder, or leave it for a volume).
# KANBA_PORT=3000
# KANBA_DATA=/path/to/a/folder

# Stripe billing (optional). Leave these out and the Billing page stays idle.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
